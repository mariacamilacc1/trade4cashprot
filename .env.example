# Copia este archivo como .env solo si vas a probar en tu computador.
# En Render NO subas .env: la clave se pega en Environment → GEMINI_API_KEY.
GEMINI_API_KEY=pega_aqui_tu_clave_de_Google_AI_Studio
# Opcional: si lo dejas vacío, el servidor prueba solo los modelos disponibles.
# GEMINI_MODEL=gemini-3.8-flash
RATE_LIMIT_PCT=15
PORT=3000
